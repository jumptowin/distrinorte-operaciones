><mxGeometry x="0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c87" value='conduce&lt;br&gt;&lt;font style="font-size:9px;color:#1e7b34"&gt;&lt;b&gt;NUEVA&lt;/b&gt;&lt;/font&gt;' style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff4d6;strokeColor=#9c6b00;strokeWidth=1.3;fontFamily=Arial;fontColor=#1a1a1a;strokeColor=#1e7b34;strokeWidth=2.4;" vertex="1" parent="1"><mxGeometry x="1400.0" y="848.0" width="130" height="66" as="geometry"/></mxCell><mxCell id="e88" value="" style="endArrow=none;html=1;strokeColor=#404040;strokeWidth=1.3;" edge="1" parent="1" source="c87" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l89" value="(0,N)" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontColor=#1a1a1a;" vertex="1" connectable="0" parent="e88"><mxGeometry x="0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e90" value="" style="endArrow=none;html=1;strokeColor=#404040;strokeWidth=1.3;" edge="1" parent="1" source="c87" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l91" value="(1,1)" style="edgeLabel;html=1;resizable=0;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontFamily=Arial;fontColor=#1a1a1a;" vertex="1" connectable="0" parent="e90"><mxGeometry x="0.6" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c92" value='&lt;b&gt;Notación&lt;/b&gt;&lt;br&gt;Rectángulo: entidad. Doble borde: entidad débil.&lt;br&gt;Rombo: relación. Doble rombo: relación identificadora.&lt;br&gt;&lt;u&gt;&lt;b&gt;subrayado&lt;/b&gt;&lt;/u&gt;: identificador. &lt;u style="text-decoration-style:dashed"&gt;punteado&lt;/u&gt;: clave parcial.&lt;br&gt;(mín, máx): participación y cardinalidad del lado de esa entidad.&lt;br&gt;Texto en cursiva bajo un rombo: atributo de la relación.&lt;br&gt;&lt;br&gt;&lt;b&gt;Cambios respecto del modelo inicial&lt;/b&gt;&lt;br&gt;Borde verde grueso y (NUEVA): entidad o relación nueva.&lt;br&gt;&lt;b&gt;+&lt;/b&gt; atributo nuevo o modificado.' style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;fontFamily=Arial;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="1600" y="1200" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>